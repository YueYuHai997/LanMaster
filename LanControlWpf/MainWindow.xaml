<Window x:Class="LanControlWpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="局域网控制工具" Width="1120" Height="760" MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Microsoft YaHei UI">
	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Margin" Value="4"/>
			<Setter Property="Padding" Value="14,7"/>
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Background" Value="#E6ECF7"/>
			<Setter Property="Foreground" Value="#1E3A5F"/>
		</Style>
		<Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
			<Setter Property="Background" Value="#DC2626"/>
		</Style>
		<Style x:Key="DeviceCard" TargetType="Border">
			<Setter Property="Background" Value="#F8FAFC"/>
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="BorderBrush" Value="#2563EB"/>
					<Setter Property="BorderThickness" Value="2"/>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsOnline}" Value="False">
					<Setter Property="Background" Value="#E2E8F0"/>
					<Setter Property="Opacity" Value="0.56"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="SelectionMark" TargetType="Border">
			<Setter Property="Background" Value="#2563EB"/>
			<Setter Property="Opacity" Value="0"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="Opacity" Value="1"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="OnlineStatus" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#16A34A"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsOnline}" Value="False">
					<Setter Property="Foreground" Value="#DC2626"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
		<Style TargetType="PasswordBox">
			<Setter Property="Padding" Value="8,5"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="90"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Border Background="#194496" Padding="28,18">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="" Foreground="#DBEAFE" FontSize="5" Margin="0,7,0,0"/>
					<TextBlock Text="局域网控制工具" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
				</StackPanel>
				<StackPanel Grid.Column="1" HorizontalAlignment="Right">
					<TextBlock x:Name="SelectionHeaderText" Text="0 台设备已选择" Foreground="#86EFAC" FontWeight="Bold" HorizontalAlignment="Right"/>
					<TextBlock x:Name="OnlineText" Text="0 台设备在线 · 0 台已保存" Foreground="White" FontSize="16" Margin="0,7,0,0"/>
				</StackPanel>
			</Grid>
		</Border>
		<TabControl x:Name="MainTabs" Grid.Row="1" Margin="22" Background="Transparent" BorderThickness="0">
			<TabItem Header="设备控制">
				<Grid Margin="6">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Border Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,12">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="设备管理" FontWeight="Bold" FontSize="20" />
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button Content="刷新设备" Style="{StaticResource Secondary}" Click="Refresh_Click"/>
								<Button Content="全选 / 取消" Style="{StaticResource Secondary}" Click="SelectAll_Click"/>
							</StackPanel>
						</Grid>
					</Border>
					<Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<ItemsControl x:Name="DeviceGrid">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Style="{StaticResource DeviceCard}" Width="224" Height="180" Margin="7" Padding="15" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="9" MouseLeftButtonUp="DeviceCard_Click">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="重启应用" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="RestartDeviceApp_Click"/>
													<MenuItem Header="执行本地 BAT" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="RunBat_Click"/>
													<Separator/>
													<MenuItem Header="远程开机（WOL）" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="WakeDevice_Click"/>
													<Separator/>
													<MenuItem Header="删除设备" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="DeleteDevice_Click"/>
												</ContextMenu>
											</Border.ContextMenu>
											<Grid>
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto"/>
													<RowDefinition Height="*"/>
													<RowDefinition Height="Auto"/>
												</Grid.RowDefinitions>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Style="{StaticResource OnlineStatus}" Text="{Binding OnlineStatus}" FontSize="12"/>
													<Border Grid.Column="1" Style="{StaticResource SelectionMark}" Width="21" Height="21" CornerRadius="11" ToolTip="已选择">
														<TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</Grid>
												<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
													<Grid Width="66" Height="52">
														<Rectangle Width="56" Height="38" Stroke="#2563EB" StrokeThickness="3" RadiusX="3" RadiusY="3" VerticalAlignment="Top"/>
														<Rectangle Width="30" Height="4" Fill="#2563EB" VerticalAlignment="Bottom"/>
														<Rectangle Width="7" Height="11" Fill="#2563EB" VerticalAlignment="Bottom"/>
													</Grid>
													<TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2"/>
													<TextBlock Text="{Binding IP}" Foreground="#64748B" HorizontalAlignment="Center"/>
												</StackPanel>
												<StackPanel Grid.Row="2">
													<TextBlock Text="{Binding RemoteStatus}" Foreground="#16A34A" FontSize="12"/>
													<TextBlock Text="{Binding AppStatus}" Foreground="#2563EB" FontSize="12" Margin="0,2,0,0"/>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>
					<Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,12,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBox x:Name="CmdBox" Width="330" Height="32" VerticalContentAlignment="Center" ToolTip="输入要在所选设备上执行的 CMD 命令，例如 ipconfig /all"/>
								<Button Content="执行 CMD" Style="{StaticResource Secondary}" Click="Command_Click"/>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal">
								<Button Content="远程关机" Style="{StaticResource Danger}" Click="Shutdown_Click"/>
								<Button Content="重启电脑" Click="Reboot_Click"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</TabItem>
			<TabItem Header="本机设置">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="32" MaxWidth="760">
						<Border Background="White" CornerRadius="8" Padding="26">
							<StackPanel>
								<TextBlock Text="本机身份与权限" FontSize="19" FontWeight="SemiBold"/>
								<TextBlock Text="保存后会自动更新局域网内的设备状态" Foreground="#64748B" Margin="0,5,0,20"/>
								<TextBlock Text="显示用户名"/>
								<TextBox x:Name="UsernameBox" Margin="0,6,0,16"/>
								<TextBlock Text="控制口令"/>
								<PasswordBox x:Name="PasswordBox" Margin="0,6,0,16"/>
								<TextBlock Text="重启应用（可选）"/>
								<Grid Margin="0,6,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox x:Name="AppPathBox"/>
									<Button Grid.Column="1" Content="浏览" Style="{StaticResource Secondary}" Click="Browse_Click"/>
								</Grid>
								<TextBlock Text="本地 BAT（可选）"/>
								<Grid Margin="0,6,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox x:Name="BatPathBox"/>
									<Button Grid.Column="1" Content="浏览" Style="{StaticResource Secondary}" Click="BrowseBat_Click"/>
								</Grid>
								<TextBlock Text="日志保存文件夹"/>
								<Grid Margin="0,6,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox x:Name="LogFolderBox"/>
									<Button Grid.Column="1" Content="浏览" Style="{StaticResource Secondary}" Click="BrowseLogFolder_Click"/>
								</Grid>
								<TextBlock Text="文件分发接收路径"/>
								<Grid Margin="0,6,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<TextBox x:Name="DistributionFolderBox"/>
									<Button Grid.Column="1" Content="浏览" Style="{StaticResource Secondary}" Click="BrowseDistributionFolder_Click"/>
								</Grid>
								<CheckBox x:Name="AllowCheck" Content="允许其他设备远程控制本机" Margin="0,0,0,10"/>
								<CheckBox x:Name="AutoHideCheck" Content="启动后自动隐藏到系统托盘" Margin="0,0,0,18"/>
								<Button Content="保存设置" HorizontalAlignment="Left" Click="Save_Click"/>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="运行日志">
				<Grid Margin="20">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<DockPanel>
						<TextBlock Text="运行日志" FontWeight="Bold" FontSize="17"/>
						<Button Content="清空日志" Style="{StaticResource Secondary}" DockPanel.Dock="Right" Click="ClearLog_Click"/>
					</DockPanel>
					<TextBox x:Name="LogBox" Grid.Row="1" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="White"/>
				</Grid>
			</TabItem>
			<TabItem Header="文件分发">
				<Grid Margin="20">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Border Background="White" CornerRadius="8" Padding="20">
						<StackPanel>
							<TextBlock Text="局域网 P2P 文件分发" FontSize="19" FontWeight="SemiBold"/>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<TextBox x:Name="DistributionSourceBox" Height="32" VerticalContentAlignment="Center" ToolTip="选择要分发的文件或文件夹"/>
								<Button Grid.Column="1" Content="选择文件" Style="{StaticResource Secondary}" Click="ChooseDistributionFile_Click"/>
								<Button Grid.Column="2" Content="选择文件夹" Style="{StaticResource Secondary}" Click="ChooseDistributionFolder_Click"/>
							</Grid>
							<StackPanel Orientation="Horizontal" Margin="0,14,0,0">
								<Button Content="创建分发任务" Click="CreateDistribution_Click"/>
								<TextBlock x:Name="DistributionHintText" VerticalAlignment="Center" Foreground="#FF0000" Margin="12,0,0,0" Text="注意！选择接受设备"/>
							</StackPanel>
						</StackPanel>
					</Border>
					<Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,16,0,0">
						<StackPanel>
							<TextBlock Text="分发任务" FontSize="17" FontWeight="SemiBold"/>
							<ItemsControl x:Name="DistributionTaskList" Margin="0,12,0,0">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="#F8FAFC" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8" Width="420" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonUp="DistributionTask_Click">
											<StackPanel>
												<TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
												<TextBlock Text="{Binding Status}" Foreground="#2563EB" Margin="0,3,0,0"/>
												<TextBlock Text="{Binding PeerSummary}" Foreground="#16A34A" FontSize="12" Margin="0,3,0,0"/>
												<TextBlock Text="{Binding SourcePath}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
