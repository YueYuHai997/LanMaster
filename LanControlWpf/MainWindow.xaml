<Window x:Class="LanControlWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="局域网控制工具"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        PreviewDragEnter="Window_DragEnter"
        PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave"
        PreviewDrop="Window_Drop"
        Background="#F4F6FA"
        FontFamily="Microsoft YaHei UI"
        Style="{StaticResource MaterialDesignWindow}">
	<Window.Resources>
		<Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="16,8" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
			<Setter Property="Margin" Value="4" />
			<Setter Property="Padding" Value="14,7" />
			<Setter Property="Background" Value="#B3261E" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style x:Key="TaskTransferButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
			<Setter Property="Foreground" Value="#C62828" />
			<Setter Property="Padding" Value="12,5" />
			<Setter Property="Margin" Value="0" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsPaused}" Value="True">
					<Setter Property="Foreground" Value="#3F51B5" />
				</DataTrigger>
				<DataTrigger Binding="{Binding ShowTransferControl}" Value="False">
					<Setter Property="Visibility" Value="Collapsed" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
			<Setter Property="Width" Value="44" />
			<Setter Property="Height" Value="44" />
			<Setter Property="Margin" Value="3,0" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style x:Key="DrawerIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
			<Setter Property="Width" Value="40" />
			<Setter Property="Height" Value="40" />
			<Setter Property="Cursor" Value="Hand" />
		</Style>
		<Style x:Key="DeviceCard" TargetType="Border">
			<Setter Property="Background" Value="#FFFFFF" />
			<Setter Property="BorderBrush" Value="#DCE3EE" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Cursor" Value="Hand" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="BorderBrush" Value="#3F51B5" />
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="Background" Value="#F1F3FF" />
				</DataTrigger>
				<DataTrigger Binding="{Binding IsOnline}" Value="False">
					<Setter Property="Background" Value="#EEF1F5" />
					<Setter Property="Opacity" Value="0.58" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="SelectionMark" TargetType="Border">
			<Setter Property="Background" Value="#3F51B5" />
			<Setter Property="Opacity" Value="0" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSelected}" Value="True">
					<Setter Property="Opacity" Value="1" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="OnlineStatus" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#18864B" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsOnline}" Value="False">
					<Setter Property="Foreground" Value="#B3261E" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="RemoteCapabilityStatus" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#18864B" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding AllowRemote}" Value="False">
					<Setter Property="Foreground" Value="#C62828" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="AppCapabilityStatus" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#3F51B5" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding HasApp}" Value="False">
					<Setter Property="Foreground" Value="#C62828" />
					<Setter Property="FontWeight" Value="SemiBold" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#4E5969" />
			<Setter Property="Margin" Value="0,10,0,4" />
		</Style>
		<Style x:Key="MutedText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#667085" />
		</Style>
		<Style x:Key="DeviceContextMenu" TargetType="ContextMenu">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinWidth" Value="236" />
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContextMenu">
						<Border Margin="10"
                                Padding="7"
                                Background="White"
                                BorderBrush="#E1E6EF"
                                BorderThickness="1"
                                CornerRadius="10">
							<Border.Effect>
								<DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#344054" />
							</Border.Effect>
							<StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="DeviceMenuItem" TargetType="MenuItem">
			<Setter Property="Foreground" Value="#344054" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="12,10" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="OverridesDefaultStyle" Value="True" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="MenuItem">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsHighlighted" Value="True">
					<Setter Property="Background" Value="#EEF1FF" />
				</Trigger>
				<Trigger Property="IsEnabled" Value="False">
					<Setter Property="Opacity" Value="0.42" />
					<Setter Property="Cursor" Value="Arrow" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource DeviceMenuItem}">
			<Setter Property="Foreground" Value="#C62828" />
		</Style>
		<Style x:Key="DeviceMenuSeparator" TargetType="Separator">
			<Setter Property="Margin" Value="10,5" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Separator">
						<Border Height="1" Background="#E4E7EC" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<materialDesign:DrawerHost x:Name="AppDrawerHost"
                               Background="#F4F6FA"
                               LeftDrawerCloseOnClickAway="True"
                               RightDrawerCloseOnClickAway="True">
		<materialDesign:DrawerHost.LeftDrawerContent>
			<Border Width="500" Background="#FAFBFD">
				<DockPanel LastChildFill="True">
					<Border DockPanel.Dock="Top" Background="White" Padding="24,18" BorderBrush="#E2E7EF" BorderThickness="0,0,0,1">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="本机设置" FontSize="22" FontWeight="SemiBold" />
								<TextBlock Text="身份、权限与本地保存位置" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
							</StackPanel>
							<Button Grid.Column="1" Style="{StaticResource DrawerIconButton}" Click="CloseSettings_Click" ToolTip="关闭设置">
								<materialDesign:PackIcon Kind="Close" Width="22" Height="22" />
							</Button>
						</Grid>
					</Border>
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="26,16,26,28">
							<TextBlock Text="身份与权限" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,2" />
							<TextBlock Text="显示用户名" Style="{StaticResource FieldLabel}" />
							<TextBox x:Name="UsernameBox" materialDesign:HintAssist.Hint="局域网内显示的名称" />
							<TextBlock Text="控制口令" Style="{StaticResource FieldLabel}" />
							<PasswordBox x:Name="PasswordBox" materialDesign:HintAssist.Hint="用于验证远程控制请求" />
							<CheckBox x:Name="AllowCheck" Content="允许其他设备远程控制本机" Margin="0,16,0,6" />
							<CheckBox x:Name="AutoHideCheck" Content="启动后自动隐藏到系统托盘" Margin="0,4,0,18" />

							<Separator Margin="0,4,0,18" />
							<TextBlock Text="本机执行路径" FontSize="17" FontWeight="SemiBold" />
							<TextBlock Text="重启应用（可选）" Style="{StaticResource FieldLabel}" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox x:Name="AppPathBox" />
								<Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Click="Browse_Click" />
							</Grid>
							<TextBlock Text="本地 BAT（可选）" Style="{StaticResource FieldLabel}" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox x:Name="BatPathBox" />
								<Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Click="BrowseBat_Click" />
							</Grid>

							<Separator Margin="0,20,0,18" />
							<TextBlock Text="保存位置" FontSize="17" FontWeight="SemiBold" />
							<TextBlock Text="日志保存文件夹" Style="{StaticResource FieldLabel}" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox x:Name="LogFolderBox" />
								<Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Click="BrowseLogFolder_Click" />
							</Grid>
							<TextBlock Text="文件分发接收路径" Style="{StaticResource FieldLabel}" />
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<TextBox x:Name="DistributionFolderBox" />
								<Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}" Click="BrowseDistributionFolder_Click" />
							</Grid>
							<Button Content="保存设置" HorizontalAlignment="Left" Margin="0,24,0,0" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
						</StackPanel>
					</ScrollViewer>
				</DockPanel>
			</Border>
		</materialDesign:DrawerHost.LeftDrawerContent>

		<materialDesign:DrawerHost.RightDrawerContent>
			<Border Width="620" Background="#FAFBFD">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border Background="White" Padding="24,18" BorderBrush="#E2E7EF" BorderThickness="0,0,0,1">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel>
								<TextBlock Text="运行日志" FontSize="22" FontWeight="SemiBold" />
								<TextBlock Text="网络发现、远程命令与文件分发记录" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
							</StackPanel>
							<Button Grid.Column="1" Style="{StaticResource DrawerIconButton}" Click="ClearLog_Click" ToolTip="清空当前日志">
								<materialDesign:PackIcon Kind="DeleteSweep" Width="21" Height="21" />
							</Button>
							<Button Grid.Column="2" Style="{StaticResource DrawerIconButton}" Click="CloseLogs_Click" ToolTip="关闭日志">
								<materialDesign:PackIcon Kind="Close" Width="22" Height="22" />
							</Button>
						</Grid>
					</Border>
					<TextBox x:Name="LogBox"
                             Grid.Row="1"
                             Margin="20"
                             Padding="14"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas"
                             Background="White" />
				</Grid>
			</Border>
		</materialDesign:DrawerHost.RightDrawerContent>

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="101*"/>
				<ColumnDefinition Width="1180*"/>
			</Grid.ColumnDefinitions>
			<Grid x:Name="WorkspaceContent" Background="#F4F6FA" Grid.ColumnSpan="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="76" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<Border Background="#263B73" Padding="24,0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<Border Width="42" Height="42" CornerRadius="11" Background="#3F51B5" Margin="0,0,13,0">
								<materialDesign:PackIcon Kind="Lan" Width="24" Height="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
							</Border>
							<StackPanel VerticalAlignment="Center">
								<TextBlock Text="局域网控制工具" FontSize="21" FontWeight="SemiBold" Foreground="White" />
								<TextBlock Text="设备控制与文件分发工作台" FontSize="12" Foreground="#C7D2FE" Margin="0,2,0,0" />
							</StackPanel>
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
							<Border Background="#1FFFFFFF" CornerRadius="14" Padding="12,6" Margin="0,0,8,0">
								<TextBlock x:Name="SelectionHeaderText" Text="0 台设备已选择" Foreground="#DDE4FF" FontWeight="SemiBold" />
							</Border>
							<TextBlock x:Name="OnlineText" Text="0 台设备在线 · 0 台已保存" Foreground="White" VerticalAlignment="Center" />
						</StackPanel>
						<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
							<Button Style="{StaticResource HeaderIconButton}" Click="ShowLogs_Click" ToolTip="查看运行日志">
								<materialDesign:PackIcon Kind="FileDocumentOutline" Width="23" Height="23" />
							</Button>
							<Button Style="{StaticResource HeaderIconButton}" Click="ShowSettings_Click" ToolTip="打开本机设置">
								<materialDesign:PackIcon Kind="Cog" Width="23" Height="23" />
							</Button>
						</StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="1" Margin="20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" MinWidth="560" />
						<ColumnDefinition Width="360" />
					</Grid.ColumnDefinitions>

					<Grid Margin="0,0,16,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<materialDesign:Card Padding="18,14" Margin="0,0,0,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel VerticalAlignment="Center">
									<TextBlock Text="设备与远程控制" FontSize="20" FontWeight="SemiBold" />
								</StackPanel>
								<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Style="{StaticResource SecondaryButton}" Click="Refresh_Click">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,7,0" />
											<TextBlock Text="刷新" />
										</StackPanel>
									</Button>
									<Button Style="{StaticResource SecondaryButton}" Click="SelectAll_Click">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="SelectAll" Width="18" Height="18" Margin="0,0,7,0" />
											<TextBlock Text="全选 / 取消" />
										</StackPanel>
									</Button>
								</StackPanel>
							</Grid>
						</materialDesign:Card>

						<materialDesign:Card Grid.Row="1" Padding="10">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<ItemsControl x:Name="DeviceGrid">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Style="{StaticResource DeviceCard}"
                                                Width="210"
                                                Height="166"
                                                Margin="7"
                                                Padding="14"
                                                CornerRadius="10"
                                                MouseLeftButtonUp="DeviceCard_Click">
												<Border.ContextMenu>
													<ContextMenu Style="{StaticResource DeviceContextMenu}">
														<MenuItem Style="{StaticResource DeviceMenuItem}" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="RestartDeviceApp_Click">
															<MenuItem.Header>
																<StackPanel Orientation="Horizontal">
																	<materialDesign:PackIcon Kind="Restart" Width="19" Height="19" Margin="0,0,11,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																	<TextBlock Text="重启应用" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																</StackPanel>
															</MenuItem.Header>
														</MenuItem>
														<MenuItem Style="{StaticResource DeviceMenuItem}" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="RunBat_Click">
															<MenuItem.Header>
																<StackPanel Orientation="Horizontal">
																	<materialDesign:PackIcon Kind="ScriptTextOutline" Width="19" Height="19" Margin="0,0,11,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																	<TextBlock Text="执行本地 BAT" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																</StackPanel>
															</MenuItem.Header>
														</MenuItem>
														<Separator Style="{StaticResource DeviceMenuSeparator}" />
														<MenuItem Style="{StaticResource DeviceMenuItem}" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.DataContext.IsOnline, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="WakeDevice_Click">
															<MenuItem.Header>
																<StackPanel Orientation="Horizontal">
																	<materialDesign:PackIcon Kind="Power" Width="19" Height="19" Margin="0,0,11,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																	<TextBlock Text="远程开机（WOL）" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																</StackPanel>
															</MenuItem.Header>
														</MenuItem>
														<Separator Style="{StaticResource DeviceMenuSeparator}" />
														<MenuItem Style="{StaticResource DangerMenuItem}" Tag="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="DeleteDevice_Click">
															<MenuItem.Header>
																<StackPanel Orientation="Horizontal">
																	<materialDesign:PackIcon Kind="DeleteOutline" Width="19" Height="19" Margin="0,0,11,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																	<TextBlock Text="删除设备" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" />
																</StackPanel>
															</MenuItem.Header>
														</MenuItem>
													</ContextMenu>
												</Border.ContextMenu>
												<Grid>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="*" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<TextBlock Style="{StaticResource OnlineStatus}" Text="{Binding OnlineStatus}" FontSize="12" />
														<Border Grid.Column="1" Style="{StaticResource SelectionMark}" Width="22" Height="22" CornerRadius="11" ToolTip="已选择">
															<TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
														</Border>
													</Grid>
													<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
														<materialDesign:PackIcon Kind="MonitorMultiple" Width="42" Height="42" Foreground="#3F51B5" HorizontalAlignment="Center" />
														<TextBlock Text="{Binding Username}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,1" />
														<TextBlock Text="{Binding IP}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
													</StackPanel>
													<Grid Grid.Row="2">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<TextBlock Text="{Binding RemoteStatus}" Style="{StaticResource RemoteCapabilityStatus}" FontSize="11" />
														<TextBlock Grid.Column="1" Text="{Binding AppStatus}" Style="{StaticResource AppCapabilityStatus}" FontSize="11" />
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</materialDesign:Card>

						<materialDesign:Card Grid.Row="2" Padding="12" Margin="0,12,0,0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBox x:Name="CmdBox" materialDesign:HintAssist.Hint="输入要在所选设备执行的 CMD 命令" />
									<Button Grid.Column="1" Content="执行 CMD" Style="{StaticResource SecondaryButton}" Click="Command_Click" />
								</Grid>
								<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
									<Button Content="远程关机" Style="{StaticResource DangerButton}" Click="Shutdown_Click" />
									<Button Content="重启电脑" Style="{StaticResource PrimaryButton}" Click="Reboot_Click" />
								</StackPanel>
							</Grid>
						</materialDesign:Card>
					</Grid>

					<materialDesign:Card Grid.Column="1" Padding="18">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<StackPanel>
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Kind="Send" Width="22" Height="22" Foreground="#3F51B5" Margin="0,1,9,0" />
									<TextBlock Text="文件分发" FontSize="20" FontWeight="SemiBold" />
								</StackPanel>
							</StackPanel>

							<StackPanel Grid.Row="1" Margin="0,20,0,0">
								<TextBlock Text="分发内容" FontWeight="SemiBold" />
								<TextBox x:Name="DistributionSourceBox" Margin="0,7,0,6" materialDesign:HintAssist.Hint="选择文件或文件夹" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Click="ChooseDistributionFile_Click">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="File" Width="17" Height="17" Margin="0,0,6,0" />
											<TextBlock Text="选择文件" />
										</StackPanel>
									</Button>
									<Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Click="ChooseDistributionFolder_Click">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="Folder" Width="17" Height="17" Margin="0,0,6,0" />
											<TextBlock Text="选择文件夹" />
										</StackPanel>
									</Button>
								</Grid>
							</StackPanel>

							<Border Grid.Row="2" Background="#EEF1FF" CornerRadius="8" Padding="12,9" Margin="0,14,0,10">
								<TextBlock x:Name="DistributionHintText" Text="请在左侧选择接收设备" Foreground="#3F51B5" FontWeight="SemiBold" TextWrapping="Wrap" />
							</Border>

							<Button Grid.Row="3" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}" Click="CreateDistribution_Click">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
									<materialDesign:PackIcon Kind="Send" Width="18" Height="18" Margin="0,0,8,0" />
									<TextBlock Text="创建分发任务" />
								</StackPanel>
							</Button>

							<Grid Grid.Row="4" Margin="0,18,0,0">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBlock Text="任务记录" FontSize="16" FontWeight="SemiBold" />
								<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
									<ItemsControl x:Name="DistributionTaskList">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="#F7F8FC" BorderBrush="#DEE3EC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,9" Cursor="Hand" MouseLeftButtonUp="DistributionTask_Click">
													<StackPanel>
														<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
														<TextBlock Text="{Binding Status}" Foreground="#3F51B5" Margin="0,4,0,0" TextWrapping="Wrap" />
												<TextBlock Text="{Binding PeerSummary}" Foreground="#18864B" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
												<TextBlock Text="{Binding SourcePath}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
												<Button Content="{Binding TransferActionText}"
														Style="{StaticResource TaskTransferButton}"
														HorizontalAlignment="Right"
														Margin="0,9,0,0"
														Click="ToggleDistributionTransfer_Click" />
											</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Grid>
						</Grid>
					</materialDesign:Card>
				</Grid>
			</Grid>

			<Grid x:Name="DropOverlay"
              Panel.ZIndex="100"
              Background="#E8F7F8FC"
              Visibility="Collapsed"
              IsHitTestVisible="False" Grid.ColumnSpan="2">
				<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36">
					<Grid Width="116" Height="108" HorizontalAlignment="Center">
						<Border Width="92" Height="92" CornerRadius="46" Background="#E8EAFB" HorizontalAlignment="Center" VerticalAlignment="Bottom">
							<materialDesign:PackIcon Kind="FileUploadOutline" Width="52" Height="52" Foreground="#3F51B5" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<Border Width="38" Height="38" CornerRadius="9" Background="White" HorizontalAlignment="Right" VerticalAlignment="Top" BorderBrush="#D9DEEA" BorderThickness="1">
							<materialDesign:PackIcon Kind="Folder" Width="21" Height="21" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
					</Grid>
					<TextBlock x:Name="DropOverlayTitle"
                           Text="释放鼠标，添加到文件分发"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#263238"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
					<TextBlock x:Name="DropOverlaySubtitle"
                           Text="支持单个文件或文件夹"
                           FontSize="15"
                           Foreground="#5F6B7A"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="560"
                           Margin="0,8,0,0" />
				</StackPanel>
			</Grid>
		</Grid>
	</materialDesign:DrawerHost>
</Window>
